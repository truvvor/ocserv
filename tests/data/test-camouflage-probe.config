auth = "plain[@SRCDIR@/data/test1.passwd]"

isolate-workers = @ISOLATE_WORKERS@

max-ban-score = 0

banner = "Welcome to VPN"
pre-login-banner = "Authorized users only"

use-dbus = no
max-clients = 16
listen-proxy-proto = false
max-same-clients = 2

tcp-port = @PORT@
udp-port = @PORT@

keepalive = 32400
dpd = 440
try-mtu-discovery = false

server-cert = @SRCDIR@/certs/server-cert.pem
server-key = @SRCDIR@/certs/server-key.pem

auth-timeout = 120
idle-timeout = 1200

rekey-time = 172800
rekey-method = ssl

use-occtl = true
socket-file = @OCCTL_SOCKET@

device = vpns
predictable-ips = true

ipv4-network = @VPNNET@
ipv4-netmask = 255.255.255.0

dns = 8.8.8.8

ping-leases = false

dtls-psk = true

# REQ-1 active probing protection
camouflage = 2
camouflage-secret = test-secret-key-12345
camouflage-tunnel-url = /api/v1/stream
# Secret path that must prefix every VPN URL
camouflage-auth-path = /s3cr3t/portal
# Enable replay detection explicitly (default at level 2)
camouflage-replay-detect = true

[vhost:default]
