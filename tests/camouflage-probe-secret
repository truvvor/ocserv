#!/bin/bash
#
# Test: REQ-1.2 secret-path auth trigger
#
# Verifies:
#   1. Request WITHOUT the secret marker returns the nginx decoy
#   2. Request WITH the secret marker returns the VPN auth form
#   3. The server log shows the distinction
#   4. A random "guessed" secret path does not unlock the auth form
#

SERV="${SERV:-../src/ocserv}"
srcdir=${srcdir:-.}
PIDFILE=ocserv-pid.$$.tmp
PATH=${PATH}:/usr/sbin
IP=$(which ip)
CURL=$(which curl)
SRVLOG=srvlog-probesecret.$$.tmp
OUT=out-probesecret.$$.tmp
HDR=hdr-probesecret.$$.tmp

. `dirname $0`/common.sh

eval "${GETPORT}"

if test -z "${IP}"; then
	echo "no IP tool is present"
	exit 77
fi
if test -z "${CURL}"; then
	echo "curl not available"
	exit 77
fi
if test "$(id -u)" != "0"; then
	echo "This test must be run as root"
	exit 77
fi

echo "Testing REQ-1.2 secret-path auth trigger..."

function finish {
  set +e
  echo " * Cleaning up..."
  test -n "${PID}" && kill ${PID} >/dev/null 2>&1
  test -n "${PIDFILE}" && rm -f ${PIDFILE} >/dev/null 2>&1
  test -n "${CONFIG}" && rm -f ${CONFIG} >/dev/null 2>&1
  rm -f ${SRVLOG} ${OUT} ${HDR} 2>&1
}
trap finish EXIT

ADDRESS=10.204.2.1
CLI_ADDRESS=10.204.1.1
VPNNET=192.168.4.0/24
VPNADDR=192.168.4.1
VPNNET6=fd91:6d87:7341:dc6c::/112
VPNADDR6=fd91:6d87:7341:dc6c::1
OCCTL_SOCKET=./occtl-probesecret-$$.socket
USERNAME=test

. `dirname $0`/ns.sh

update_config test-camouflage-probe.config
if test "$VERBOSE" = 1; then
	DEBUG="-d 4"
fi

${CMDNS2} ${SERV} -p ${PIDFILE} -f -c ${CONFIG} -d 3 2>${SRVLOG} & PID=$!
sleep 4

if ! kill -0 ${PID} 2>/dev/null; then
	echo "FAIL: Server did not start"
	cat ${SRVLOG}
	exit 1
fi

# ============================================================
# TEST 1: Without secret path -> nginx 404 decoy
# ============================================================
echo " * [TEST 1] GET /auth (no secret marker)..."
${CMDNS1} ${CURL} -k --http1.1 -s -D ${HDR} "https://${ADDRESS}:${PORT}/auth" \
	-o ${OUT} > /dev/null 2>&1 || true

if ! grep -qi "^Server: nginx" ${HDR}; then
	echo "FAIL: /auth without marker did not return nginx header"
	cat ${HDR}
	exit 1
fi
if ! grep -qi "^HTTP/1.[01] 404" ${HDR}; then
	echo "FAIL: /auth without marker did not return 404 status"
	cat ${HDR}
	exit 1
fi
if ! grep -q "nginx/1.24.0" ${OUT}; then
	echo "FAIL: /auth without marker did not return nginx 404 body"
	cat ${OUT}
	exit 1
fi
echo "   PASS: /auth without marker returned nginx 404 decoy"

# ============================================================
# TEST 1b: GET / without marker -> nginx welcome page
# ============================================================
echo " * [TEST 1b] GET / (no secret marker)..."
${CMDNS1} ${CURL} -k --http1.1 -s -D ${HDR} "https://${ADDRESS}:${PORT}/" \
	-o ${OUT} > /dev/null 2>&1 || true

if ! grep -qi "^Server: nginx" ${HDR}; then
	echo "FAIL: / without marker did not return nginx header"
	cat ${HDR}
	exit 1
fi
if ! grep -q "Welcome to nginx" ${OUT}; then
	echo "FAIL: / without marker did not return welcome page"
	cat ${OUT}
	exit 1
fi
echo "   PASS: / without marker returned nginx welcome page"

# ============================================================
# TEST 2: Guessed path -> still decoy
# ============================================================
echo " * [TEST 2] GET /s3cr3t/auth (partial/guessed marker)..."
${CMDNS1} ${CURL} -k --http1.1 -s -D ${HDR} "https://${ADDRESS}:${PORT}/s3cr3t/auth" \
	-o ${OUT} > /dev/null 2>&1 || true

if ! grep -qi "^Server: nginx" ${HDR}; then
	echo "FAIL: partial marker unexpectedly served non-nginx headers"
	cat ${HDR}
	exit 1
fi
echo "   PASS: partial marker served decoy"

# ============================================================
# TEST 3: Correct marker -> VPN auth endpoint
# ============================================================
echo " * [TEST 3] GET /s3cr3t/portal/ (correct marker)..."
${CMDNS1} ${CURL} -k --http1.1 -s -D ${HDR} "https://${ADDRESS}:${PORT}/s3cr3t/portal/" \
	-o ${OUT} > /dev/null 2>&1 || true

# With the marker, the URL is rewritten to "/" and the auth handler
# runs. The auth handler on camouflage=2 returns an XML response
# (auth form). It must NOT return the nginx Server header.
if grep -qi "^Server: nginx" ${HDR}; then
	echo "FAIL: correct marker unexpectedly returned nginx headers"
	cat ${HDR}
	exit 1
fi
echo "   PASS: correct marker unmasked the auth endpoint"

# The auth response body should look like XML from the VPN auth handler
if grep -q "<?xml" ${OUT} || grep -qi "auth" ${HDR}; then
	echo "   PASS: auth endpoint returned a response (XML/auth)"
else
	echo "   INFO: auth response was not XML (may be a redirect)"
	head -20 ${HDR}
fi

# ============================================================
# TEST 4: Correct marker prefix on /auth path
# ============================================================
echo " * [TEST 4] GET /s3cr3t/portal/auth (marker + subpath)..."
${CMDNS1} ${CURL} -k --http1.1 -s -D ${HDR} "https://${ADDRESS}:${PORT}/s3cr3t/portal/auth" \
	-o ${OUT} > /dev/null 2>&1 || true

if grep -qi "^Server: nginx" ${HDR}; then
	echo "FAIL: marker+subpath returned nginx headers"
	cat ${HDR}
	exit 1
fi
echo "   PASS: marker+subpath unmasked auth"

# ============================================================
# TEST 5: Server log confirms behavior
# ============================================================
echo " * [TEST 5] Checking server log..."
if grep -q "camouflage: missing auth marker" ${SRVLOG}; then
	echo "   PASS: Server logged the decoy-served probes"
else
	echo "   INFO: Server log does not mention marker (may need -d 4)"
fi

echo ""
echo "============================================"
echo " REQ-1.2 Secret-Path Trigger: ALL TESTS PASSED"
echo "============================================"

exit 0
