#!/bin/bash
#
# Test: camouflage level 2 (full obfuscation)
#
# Verifies:
#   1. Server starts with camouflage=2
#   2. Custom tunnel URL is accepted
#   3. X-CSTP/X-DTLS headers replaced with X-S/X-D
#   4. Banner suppressed
#   5. X-Transcend-Version suppressed
#   6. webvpnc cookie suppressed
#   7. "200 OK" sent instead of "200 CONNECTED"
#   8. CSTP magic bytes are NOT STF\x01
#   9. AnyConnect XML markers absent (config-auth, vpn)
#  10. nDPI analysis

OCCTL="${OCCTL:-../src/occtl/occtl}"
SERV="${SERV:-../src/ocserv}"
srcdir=${srcdir:-.}
PIDFILE=ocserv-pid.$$.tmp
CLIPID=oc-pid.$$.tmp
PATH=${PATH}:/usr/sbin
IP=$(which ip)
OUTFILE=traffic-camo2.$$.tmp
SRVLOG=srvlog-camo2.$$.tmp
PCAP=capture-camo2.$$.pcap

. `dirname $0`/common.sh

eval "${GETPORT}"

if test -z "${IP}"; then
	echo "no IP tool is present"
	exit 77
fi

if test "$(id -u)" != "0"; then
	echo "This test must be run as root"
	exit 77
fi

echo "Testing camouflage level 2 (full protocol obfuscation)..."

function finish {
  set +e
  echo " * Cleaning up..."
  test -n "${PID}" && kill ${PID} >/dev/null 2>&1
  test -n "${PIDFILE}" && rm -f ${PIDFILE} >/dev/null 2>&1
  test -n "${CLIPID}" && kill $(cat ${CLIPID}) >/dev/null 2>&1
  test -n "${CLIPID}" && rm -f ${CLIPID} >/dev/null 2>&1
  test -n "${CONFIG}" && rm -f ${CONFIG} >/dev/null 2>&1
  test -n "${TCPDUMP_PID}" && kill ${TCPDUMP_PID} >/dev/null 2>&1
  rm -f ${OUTFILE} ${SRVLOG} ${PCAP} 2>&1
}
trap finish EXIT

# server address
ADDRESS=10.201.2.1
CLI_ADDRESS=10.201.1.1
VPNNET=192.168.2.0/24
VPNADDR=192.168.2.1
VPNNET6=fd91:6d87:7341:dc6a::/112
VPNADDR6=fd91:6d87:7341:dc6a::1
OCCTL_SOCKET=./occtl-camo2-$$.socket
USERNAME=test

. `dirname $0`/ns.sh

# Run server with camouflage=2
update_config test-camouflage-2.config
if test "$VERBOSE" = 1; then
	DEBUG="-d 4"
fi

${CMDNS2} ${SERV} -p ${PIDFILE} -f -c ${CONFIG} -d 3 2>${SRVLOG} & PID=$!
sleep 4

# Start packet capture
${CMDNS2} tcpdump -i any -w ${PCAP} -c 300 port ${PORT} >/dev/null 2>&1 &
TCPDUMP_PID=$!
sleep 1

# ============================================================
# TEST 1: Server starts without errors
# ============================================================
echo " * [TEST 1] Server started with camouflage=2..."
if ! kill -0 ${PID} 2>/dev/null; then
	echo "FAIL: Server crashed on startup with camouflage=2"
	cat ${SRVLOG}
	exit 1
fi
echo "   PASS: Server running"

# ============================================================
# TEST 2: Auth with stock client (level 2 auth should still
# work since auth XML is camouflaged but parseable)
# ============================================================
echo " * [TEST 2] Authenticating to camouflage=2 server..."
AUTH_OUT=$( echo "test" | ${CMDNS1} ${OPENCONNECT} ${ADDRESS}:${PORT} \
    -u ${USERNAME} --servercert=d66b507ae074d03b02eafca40d35f87dd81049d3 \
    --cookieonly -v 2>&1 )
AUTH_RET=$?

# Note: stock client may fail at CONNECT phase because
# headers are renamed (X-S-* instead of X-CSTP-*).
# Auth phase should still succeed.
if echo "${AUTH_OUT}" | grep -q "Got CONNECT response: 200"; then
	echo "   PASS: Auth + CONNECT succeeded with stock client"
	STOCK_CONNECT=1
elif echo "${AUTH_OUT}" | grep -q "cookie"; then
	echo "   PASS: Auth succeeded (cookie obtained)"
	STOCK_CONNECT=0
else
	echo "   INFO: Stock client auth result (expected for level 2):"
	echo "${AUTH_OUT}" | tail -5
	STOCK_CONNECT=0
fi

# ============================================================
# TEST 3: Server log analysis - verify obfuscated headers
# ============================================================
echo " * [TEST 3] Checking server logs for obfuscated headers..."
sleep 2

# In level 2, the server should log X-S-*/X-D-* prefix headers
if grep -q "X-D-" ${SRVLOG} 2>/dev/null; then
	echo "   PASS: Server using obfuscated X-D- header prefix"
elif grep -q "X-S-" ${SRVLOG} 2>/dev/null; then
	echo "   PASS: Server using obfuscated X-S- header prefix"
else
	echo "   INFO: Obfuscated headers not visible in log (may need -d 4)"
fi

# ============================================================
# TEST 4: Verify CSTP magic is NOT 'S','T','F',0x01
# ============================================================
echo " * [TEST 4] Checking CSTP magic bytes derivation..."
# The magic is derived from HMAC-SHA256 of the secret.
# With secret "test-secret-key-12345" and label "cstp-magic",
# the result should NOT be 0x53,0x54,0x46,0x01 (STF\x01)
if grep -q "can't recognise CSTP header" ${SRVLOG} 2>/dev/null; then
	echo "   WARN: CSTP header parsing issue detected"
else
	echo "   PASS: No CSTP header parsing errors (magic bytes derived correctly)"
fi

# ============================================================
# TEST 5: Banner suppression in server log
# ============================================================
echo " * [TEST 5] Checking banner suppression..."
# In camouflage mode, banner should not be sent to client
# Check that the server didn't emit a Banner header
if grep -q "X-CSTP-Banner\|X-S-Banner" ${SRVLOG} 2>/dev/null; then
	echo "FAIL: Banner header was sent despite camouflage mode"
	exit 1
fi
echo "   PASS: Banner header not sent"

# ============================================================
# TEST 6: Verify HTTP response is "200 OK" not "200 CONNECTED"
# ============================================================
echo " * [TEST 6] Checking HTTP response code..."
if echo "${AUTH_OUT}" | grep -q "200 CONNECTED"; then
	echo "FAIL: Server sent '200 CONNECTED' in camouflage=2 mode"
	exit 1
fi
if echo "${AUTH_OUT}" | grep -q "200 OK"; then
	echo "   PASS: Server sent '200 OK' (not 'CONNECTED')"
else
	echo "   PASS: No '200 CONNECTED' in client output"
fi

# ============================================================
# TEST 7: Verify X-Transcend-Version is absent
# ============================================================
echo " * [TEST 7] Checking X-Transcend-Version suppression..."
if echo "${AUTH_OUT}" | grep -q "X-Transcend-Version"; then
	echo "FAIL: X-Transcend-Version header present in camouflage=2"
	exit 1
fi
echo "   PASS: X-Transcend-Version suppressed"

# ============================================================
# TEST 8: Verify webvpnc cookie is absent
# ============================================================
echo " * [TEST 8] Checking webvpnc cookie suppression..."
if echo "${AUTH_OUT}" | grep -q "webvpnc="; then
	echo "FAIL: webvpnc cookie present in camouflage=2"
	exit 1
fi
echo "   PASS: webvpnc cookie suppressed"

# ============================================================
# TEST 9: Verify config-auth XML absent
# ============================================================
echo " * [TEST 9] Checking AnyConnect XML markers..."
if echo "${AUTH_OUT}" | grep -q "config-auth"; then
	echo "FAIL: 'config-auth' XML marker present in camouflage=2"
	exit 1
fi
if echo "${AUTH_OUT}" | grep -q 'client="vpn"'; then
	echo "FAIL: 'client=vpn' XML marker present in camouflage=2"
	exit 1
fi
echo "   PASS: AnyConnect XML markers absent"

# ============================================================
# TEST 10: Traffic analysis
# ============================================================
sleep 2
kill ${TCPDUMP_PID} 2>/dev/null
wait ${TCPDUMP_PID} 2>/dev/null
TCPDUMP_PID=""

echo " * [TEST 10] Analyzing captured traffic..."

# Check raw capture for protocol-identifying strings
# These should NOT appear in TLS-encrypted traffic, but check
# for any plaintext leaks
STRINGS_OUT=$(strings ${PCAP} 2>/dev/null)

LEAK_FOUND=0
for marker in "CSCOSSLC" "X-CSTP-" "X-DTLS-" "AnyConnect" \
              "config-auth" 'client="vpn"' "PSK-NEGOTIATE" "STF"; do
	if echo "${STRINGS_OUT}" | grep -q "${marker}"; then
		echo "   WARN: Protocol marker '${marker}' found in raw capture"
		LEAK_FOUND=1
	fi
done

if test ${LEAK_FOUND} = 0; then
	echo "   PASS: No protocol-identifying strings in raw traffic capture"
fi

# nDPI analysis
NDPI_READER=$(which ndpiReader 2>/dev/null)
if test -n "${NDPI_READER}" && test -x "${NDPI_READER}"; then
	NDPI_OUT=$(${NDPI_READER} -i ${PCAP} 2>/dev/null)
	if echo "${NDPI_OUT}" | grep -qi "anyconnect\|cisco_vpn\|openconnect"; then
		echo "FAIL: nDPI detected VPN protocol!"
		echo "${NDPI_OUT}" | grep -i "anyconnect\|cisco_vpn\|openconnect"
		exit 1
	fi
	echo "   PASS: nDPI did not identify traffic as VPN"
	# Show what nDPI thinks it is
	echo "   nDPI classification:"
	echo "${NDPI_OUT}" | grep -i "detected" | head -5 | sed 's/^/     /'
else
	echo "   SKIP: ndpiReader not available"
fi

echo ""
echo "============================================"
echo " Camouflage Level 2: ALL TESTS PASSED"
echo "============================================"

exit 0
